# Copy to backend/.env (gitignored) for `python backend/local.py`.
# OpenRouter keys for the AI brief and questions, comma-separated, tried in order. Free-tier keys work with :free models.
OPENROUTER_KEYS=
# Optional: models OpenRouter falls back across, in order
# OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free
