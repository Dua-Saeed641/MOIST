# Leave API url unset to use simulated data. Local API: http://localhost:8787
VITE_API_URL=
VITE_API_KEY=

# Basemap. Unset = OpenStreetMap (no key). Example (MapTiler):
# VITE_MAP_TILE_URL=https://api.maptiler.com/maps/dataviz-light/{z}/{x}/{y}.png?key=YOUR_KEY
# VITE_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
